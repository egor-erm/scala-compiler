Grammar

    0 $accept: program $end

    1 program: semis_e
    2        | semis_e top_list semis_e

    3 top_list: top_stat
    4         | top_list semis top_stat

    5 top_stat: import
    6         | class_def

    7 import: IMPORT path

    8 path: ID
    9     | path '.' ID

   10 semi: ';'
   11     | NL

   12 semis: semi
   13      | semis semi

   14 semis_e: %empty
   15        | semis

   16 nls: %empty
   17    | nls NL

   18 nl_e: %empty
   19     | NL

   20 stmt: def
   21     | expr

   22 def: func_def
   23    | var_def

   24 def_prefix: ABSTRACT
   25           | SEALED
   26           | FINAL
   27           | OVERRIDE
   28           | PRIVATE
   29           | PROTECTED

   30 def_prefix_list: %empty
   31                | def_prefix_list def_prefix

   32 class_def: def_prefix_list CLASS ID class_tail
   33          | def_prefix_list CLASS ID class_fields class_tail
   34          | def_prefix_list OBJECT ID class_tail

   35 class_fields: nls '(' ')'
   36             | nls '(' field_list ')'

   37 class_tail: class_body
   38           | EXTENDS ID args_e class_body

   39 args_e: %empty
   40       | args

   41 args: '(' ')'
   42     | '(' expr_list ')'

   43 class_body: nls '{' stmt_list_e '}'

   44 stmt_list_e: semis_e
   45            | semis_e stmt_list semis_e

   46 stmt_list: stmt
   47          | stmt_list semis stmt

   48 id_list: ID
   49        | id_list ',' ID

   50 field_list: field
   51           | field_list ',' field

   52 field: ID ':' type
   53      | def_prefix_list val_or_var ID ':' type

   54 val_or_var: VAL
   55           | VAR

   56 func_def: def_prefix_list DEF ID params_e type_e '=' expr
   57         | def_prefix_list DEF ID params_e ':' type
   58         | def_prefix_list DEF THIS params_e '=' expr

   59 var_def: def_prefix_list val_or_var id_list type_e '=' expr
   60        | def_prefix_list val_or_var id_list ':' type

   61 params_e: %empty
   62         | nl_e '(' param_list_e ')'

   63 param_list_e: %empty
   64             | param_list

   65 param_list: ID ':' type
   66           | param_list ',' ID ':' type

   67 type: ID
   68     | ID '.' ID
   69     | TARRAY '[' type ']'

   70 type_e: %empty
   71       | ':' type

   72 block_stats: semis_e
   73            | semis_e block_list semis_e

   74 block_list: block_stat
   75           | block_list semis block_stat

   76 block_stat: local_def
   77           | expr

   78 local_def: val_or_var id_list type_e '=' expr

   79 expr: if_expr
   80     | while_expr
   81     | do_while_expr
   82     | for_expr
   83     | TRY expr catch_e finally_e
   84     | THROW expr
   85     | RETURN
   86     | RETURN expr
   87     | simple '=' expr
   88     | simple PLUS_ASSIGN nl_e expr
   89     | simple MINUS_ASSIGN nl_e expr
   90     | simple STAR_ASSIGN nl_e expr
   91     | simple SLASH_ASSIGN nl_e expr
   92     | simple PERCENT_ASSIGN nl_e expr
   93     | simple AND_ASSIGN nl_e expr
   94     | simple OR_ASSIGN nl_e expr
   95     | infix

   96 if_expr: IF '(' expr ')' nls expr
   97        | IF '(' expr ')' nls expr ELSE expr

   98 while_expr: WHILE '(' expr ')' nls expr

   99 do_while_expr: DO expr semis_e WHILE '(' expr ')'

  100 for_expr: FOR '(' generator_list ')' nls expr
  101         | FOR '{' semis_e generator_list semis_e '}' nls expr

  102 generator_list: generator
  103               | generator_list semis generator
  104               | generator_list semis IF expr
  105               | generator_list IF expr

  106 generator: ID L_ARROW expr

  107 catch_e: %empty
  108        | CATCH '{' case_list '}'

  109 case_list: case
  110          | case_list case

  111 case: CASE ID ':' type R_ARROW block_stats

  112 finally_e: %empty
  113          | FINALLY expr

  114 infix: prefix
  115      | infix ID nl_e infix
  116      | infix OR nl_e infix
  117      | infix AND nl_e infix
  118      | infix '|' nl_e infix
  119      | infix '^' nl_e infix
  120      | infix '&' nl_e infix
  121      | infix EQ nl_e infix
  122      | infix NEQ nl_e infix
  123      | infix '<' nl_e infix
  124      | infix '>' nl_e infix
  125      | infix LESS_EQ nl_e infix
  126      | infix GREATER_EQ nl_e infix
  127      | infix SHL nl_e infix
  128      | infix SHR nl_e infix
  129      | infix '+' nl_e infix
  130      | infix '-' nl_e infix
  131      | infix '*' nl_e infix
  132      | infix '/' nl_e infix
  133      | infix '%' nl_e infix

  134 prefix: simple
  135       | '-' simple
  136       | '+' simple
  137       | '!' simple
  138       | '~' simple

  139 expr_list: expr
  140          | expr_list ',' expr

  141 simple: literal
  142       | ID
  143       | THIS
  144       | SUPER '.' ID
  145       | simple '.' ID
  146       | simple args
  147       | '(' expr ')'
  148       | '{' block_stats '}'
  149       | NEW ID args
  150       | NEW TARRAY '[' type ']' '(' expr ')'
  151       | TARRAY args
  152       | TARRAY '[' type ']' args
  153       | TARRAY '.' ID '[' type ']' args

  154 literal: LITINT
  155        | LITCHAR
  156        | LITBOOL
  157        | LITDOUBLE
  158        | LITSTR
  159        | KNULL
  160        | '(' ')'


