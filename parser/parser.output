Terminals unused in grammar

    TLIST


State 418 conflicts: 1 shift/reduce


Grammar

    0 $accept: program $end

    1 program: %empty
    2        | program stmt

    3 stmt: def
    4     | expr ';'

    5 def: func_def ';'
    6    | var_def ';'
    7    | class_def ';'
    8    | trait_def ';'
    9    | def_prefix def

   10 def_prefix: ABSTRACT
   11           | SEALED
   12           | FINAL
   13           | OVERRIDE
   14           | LAZY

   15 trait_def: TRAIT ID
   16          | TRAIT ID '{' def_list_e '}'
   17          | TRAIT ID EXTENDS id_with_id
   18          | TRAIT ID EXTENDS id_with_id '{' def_list_e '}'

   19 class_def: CLASS ID
   20          | CLASS ID '{' def_list_e '}'
   21          | CLASS ID EXTENDS id_with_id
   22          | CLASS ID EXTENDS id_with_id '{' def_list_e '}'
   23          | CLASS ID '(' field_list_e ')'
   24          | CLASS ID '(' field_list_e ')' '{' def_list_e '}'
   25          | CLASS ID '(' field_list_e ')' EXTENDS id_with_id
   26          | CLASS ID '(' field_list_e ')' EXTENDS id_with_id '{' def_list_e '}'

   27 id_with_id: ID
   28           | ID '(' id_list_e ')'
   29           | id_with_id WITH ID
   30           | id_with_id WITH ID '(' id_list_e ')'

   31 id_list_e: %empty
   32          | id_list

   33 id_list: ID
   34        | id_list ',' ID

   35 field_list_e: %empty
   36             | field_list

   37 field_list: field
   38           | field_list ',' field

   39 field: VAL ID ':' type
   40      | VAR ID ':' type

   41 def_list_e: %empty
   42           | def_list

   43 def_list: def
   44         | def_list def

   45 func_def: DEF ID '(' param_list_e ')' '=' expr
   46         | DEF ID '(' param_list_e ')' ':' type '=' expr
   47         | VAL ID '=' '(' param_list_e ')' R_ARROW expr

   48 var_def: VAL ID '=' expr
   49        | VAR ID '=' expr
   50        | VAL ID ':' type '=' expr
   51        | VAR ID ':' type '=' expr
   52        | VAL ID '=' expr '_'

   53 param_list_e: %empty
   54             | param_list

   55 param_list: ID ':' type
   56           | param_list ',' ID ':' type

   57 type: var_type
   58     | func_type

   59 var_type: TINT
   60         | TCHAR
   61         | TSTR
   62         | TARRAY
   63         | TARRAY '[' type ']'

   64 func_type: '(' ')' R_ARROW type
   65          | '(' type_list ')' R_ARROW type

   66 type_list: type
   67          | type_list ',' type

   68 type_e: %empty
   69       | '[' type ']'

   70 read_type: READINT
   71          | READCHAR
   72          | READLINE

   73 expr: ID
   74     | SUPER
   75     | '(' expr ')' R_ARROW expr
   76     | '_'
   77     | LITINT
   78     | LITCHAR
   79     | LITSTR
   80     | '(' expr ')'
   81     | '{' program '}'
   82     | expr '+' expr
   83     | expr '-' expr
   84     | expr '*' expr
   85     | expr '/' expr
   86     | expr '%' expr
   87     | '+' expr
   88     | '-' expr
   89     | expr EQ expr
   90     | expr NEQ expr
   91     | expr '<' expr
   92     | expr '>' expr
   93     | expr LESS_EQ expr
   94     | expr GREATER_EQ expr
   95     | expr '=' expr
   96     | expr PLUS_ASSIGN expr
   97     | expr MINUS_ASSIGN expr
   98     | expr STAR_ASSIGN expr
   99     | expr SLASH_ASSIGN expr
  100     | expr PERCENT_ASSIGN expr
  101     | var_type '(' expr_list ')'
  102     | NEW var_type '(' expr ')'
  103     | NEW ID '(' expr_list ')'
  104     | expr '.' array_postfix
  105     | expr '(' expr ')'
  106     | if_expr
  107     | while_expr
  108     | do_while_expr
  109     | for_expr
  110     | SCALA '.' IO '.' STDIN '.' read_type '(' ')'
  111     | PRINT '(' expr ')'
  112     | PRINTLN '(' expr ')'
  113     | PRINTF '(' expr_list ')'
  114     | expr '.' ID

  115 if_expr: IF '(' expr ')' expr
  116        | IF '(' expr ')' expr ELSE expr

  117 while_expr: WHILE '(' expr ')' expr

  118 do_while_expr: DO expr WHILE '(' expr ')'

  119 for_expr: FOR '(' generator_list ')' expr
  120         | FOR '{' generator_list '}' YIELD expr
  121         | expr '.' for_expr_postfix

  122 generator_list: ID L_ARROW expr range_e
  123               | generator_list ';' ID L_ARROW expr range_e
  124               | generator_list ';' IF expr
  125               | generator_list ';' expr

  126 range_e: %empty
  127        | TO expr
  128        | UNITL expr
  129        | TO expr BY expr
  130        | UNITL expr BY expr

  131 expr_list: expr
  132          | expr_list ',' expr

  133 expr_list_e: %empty
  134            | expr_list

  135 array_postfix: EMPTY type_e
  136              | APPLY '(' expr_list_e ')'
  137              | FILL type_e '(' expr ')' '(' expr ')'
  138              | TABULATE type_e '(' expr ')' '(' ID R_ARROW expr ')'
  139              | ITERATE type_e '(' expr ',' expr ')' '(' ID R_ARROW expr ')'
  140              | RANGE '(' expr ',' expr ')'
  141              | RANGE '(' expr ',' expr ',' expr ')'
  142              | CONCAT '(' expr_list_e ')'
  143              | COPY '(' expr ',' expr ',' expr ',' expr ',' expr ')'
  144              | COPY_OF '(' expr ',' expr ')'
  145              | FROM type_e '(' expr ')'
  146              | HEAD
  147              | HEAD_OPTION
  148              | LAST
  149              | LAST_OPTION
  150              | LIFT '(' expr ')'
  151              | APPLY_OR_ELSE '(' expr ',' expr ')'
  152              | UPDATE '(' expr ',' expr ')'
  153              | TO_ARRAY

  154 mk_string_postfix: MK_STRING '(' ')'
  155                  | MK_STRING '(' expr ')'
  156                  | MK_STRING '(' expr ',' expr ',' expr ')'

  157 for_expr_postfix: FOREACH '(' expr ')'
  158                 | TAPEACH '(' expr ')'
  159                 | FILTER '(' expr ')'
  160                 | FILTER_NOT '(' expr ')'
  161                 | PARTITION '(' expr ')'
  162                 | PARTITION_MAP '(' expr ')'
  163                 | DISTINCT
