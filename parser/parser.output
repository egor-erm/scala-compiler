State 380 conflicts: 1 shift/reduce


Grammar

    0 $accept: program $end

    1 program: %empty
    2        | program stmt

    3 stmt: def
    4     | expr ';'

    5 def: func_def ';'
    6    | var_def ';'

    7 func_def: DEF ID '(' param_list_e ')' '=' expr
    8         | DEF ID '(' param_list_e ')' ':' type '=' expr
    9         | VAL ID '=' '(' param_list_e ')' R_ARROW expr

   10 var_def: VAL ID '=' expr
   11        | VAR ID '=' expr
   12        | VAL ID ':' type '=' expr
   13        | VAR ID ':' type '=' expr
   14        | VAL ID '=' expr '_'

   15 param_list_e: %empty
   16             | param_list

   17 param_list: ID ':' type
   18           | param_list ',' ID ':' type

   19 type: var_type
   20     | func_type

   21 var_type: TINT
   22         | TCHAR
   23         | TSTR
   24         | TARRAY
   25         | TARRAY '[' type ']'

   26 func_type: '(' ')' R_ARROW type
   27          | '(' type_list ')' R_ARROW type

   28 type_list: type
   29          | type_list ',' type

   30 type_e: %empty
   31       | '[' type ']'

   32 read_type: READINT
   33          | READCHAR
   34          | READLINE

   35 expr: ID
   36     | '(' expr ')' R_ARROW expr
   37     | '_'
   38     | LITINT
   39     | LITCHAR
   40     | LITSTR
   41     | '(' expr ')'
   42     | '{' program '}'
   43     | expr '+' expr
   44     | expr '-' expr
   45     | expr '*' expr
   46     | expr '/' expr
   47     | expr '%' expr
   48     | '+' expr
   49     | '-' expr
   50     | expr EQ expr
   51     | expr NEQ expr
   52     | expr '<' expr
   53     | expr '>' expr
   54     | expr LESS_EQ expr
   55     | expr GREATER_EQ expr
   56     | expr '=' expr
   57     | expr PLUS_ASSIGN expr
   58     | expr MINUS_ASSIGN expr
   59     | expr STAR_ASSIGN expr
   60     | expr SLASH_ASSIGN expr
   61     | expr PERCENT_ASSIGN expr
   62     | var_type '(' expr_list ')'
   63     | NEW var_type '(' expr ')'
   64     | expr '.' array_postfix
   65     | expr '(' expr ')'
   66     | if_expr
   67     | while_expr
   68     | do_while_expr
   69     | for_expr
   70     | SCALA '.' IO '.' STDIN '.' read_type '(' ')'
   71     | PRINT '(' expr ')'
   72     | PRINTLN '(' expr ')'
   73     | PRINTF '(' expr_list ')'

   74 if_expr: IF '(' expr ')' expr
   75        | IF '(' expr ')' expr ELSE expr

   76 while_expr: WHILE '(' expr ')' expr

   77 do_while_expr: DO expr WHILE '(' expr ')'

   78 for_expr: FOR '(' generator_list ')' expr
   79         | FOR '{' generator_list '}' YIELD expr
   80         | expr '.' for_expr_postfix

   81 generator_list: ID L_ARROW expr range_e
   82               | generator_list ';' ID L_ARROW expr range_e
   83               | generator_list ';' IF expr
   84               | generator_list ';' expr

   85 range_e: %empty
   86        | TO expr
   87        | UNITL expr
   88        | TO expr BY expr
   89        | UNITL expr BY expr

   90 expr_list: expr
   91          | expr_list ',' expr

   92 expr_list_e: %empty
   93            | expr_list

   94 array_postfix: EMPTY type_e
   95              | APPLY '(' expr_list_e ')'
   96              | FILL type_e '(' expr ')' '(' expr ')'
   97              | TABULATE type_e '(' expr ')' '(' ID R_ARROW expr ')'
   98              | ITERATE type_e '(' expr ',' expr ')' '(' ID R_ARROW expr ')'
   99              | RANGE '(' expr ',' expr ')'
  100              | RANGE '(' expr ',' expr ',' expr ')'
  101              | CONCAT '(' expr_list_e ')'
  102              | COPY '(' expr ',' expr ',' expr ',' expr ',' expr ')'
