Grammar

    0 $accept: program $end

    1 program: stmt_list_e

    2 stmt_list_e: %empty
    3            | stmt_list

    4 stmt_list: stmt
    5          | stmt_list stmt

    6 stmt: def SEPARATOR
    7     | expr SEPARATOR
    8     | output SEPARATOR
    9     | input SEPARATOR

   10 def: var_def
   11    | func_def
   12    | class_def
   13    | trait_def
   14    | aux_constructor_def
   15    | final_func_def
   16    | enum_def

   17 var_def: VAL ID opt_type_ann ASSIGN expr
   18        | VAR ID opt_type_ann ASSIGN expr

   19 opt_type_ann: %empty
   20             | COLON type

   21 type: simple_type
   22     | simple_type WITH trait_list

   23 simple_type: TINT
   24            | TCHAR
   25            | TSTR
   26            | TDOUBLE
   27            | TFLOAT
   28            | TBOOL
   29            | TARRAY
   30            | TARRAY SQ_LPAR type SQ_RPAR
   31            | TLIST SQ_LPAR type SQ_RPAR
   32            | EITHER SQ_LPAR type COMMA type SQ_RPAR
   33            | OPTION SQ_LPAR type SQ_RPAR
   34            | ID

   35 func_def: DEF ID LPAR param_list_e RPAR COLON type ASSIGN expr
   36         | DEF ID LPAR param_list_e RPAR ASSIGN expr
   37         | DEF ID COLON type ASSIGN expr
   38         | DEF ID ASSIGN expr
   39         | DEF ID param_list_e_seq COLON type ASSIGN expr
   40         | DEF ID param_list_e_seq ASSIGN expr
   41         | VAL ID COLON type RARROW type ASSIGN ID RARROW expr
   42         | VAL ID COLON LPAR type_list_e RPAR RARROW type ASSIGN LPAR id_list_e RPAR RARROW expr
   43         | VAL ID ASSIGN LPAR param_list_e RPAR RARROW expr
   44         | VAL ID COLON type RARROW type ASSIGN expr
   45         | VAL ID COLON LPAR type_list_e RPAR RARROW type ASSIGN expr
   46         | VAL ID COLON type RARROW type ASSIGN CURV_LPAR ID RARROW stmt_list expr CURV_RPAR
   47         | VAL ID COLON LPAR type_list_e RPAR RARROW type ASSIGN CURV_LPAR ID RARROW stmt_list expr CURV_RPAR

   48 final_func_def: FINAL func_def

   49 param_list_e_seq: LPAR param_list_e RPAR
   50                 | param_list_e_seq LPAR param_list_e RPAR

   51 id_list_e: %empty
   52          | id_list

   53 id_list: ID
   54        | id_list COMMA ID

   55 type_list_e: %empty
   56            | type_list

   57 type_list: type
   58          | type_list COMMA type

   59 param_list_e: %empty
   60             | param_list

   61 param_list: param
   62           | param_list COMMA param

   63 param: ID COLON type
   64      | ID COLON type ASSIGN expr
   65      | ID COLON type STAR
   66      | ID COLON type RARROW type
   67      | ID COLON LPAR type_list_e RPAR RARROW type

   68 class_id: CLASS ID
   69         | FINAL CLASS ID
   70         | ABSTRACT CLASS ID
   71         | SEALED CLASS ID
   72         | SEALED ABSTRACT CLASS ID

   73 trait_list: ID
   74           | trait_list WITH ID

   75 class_def: class_id class_params_opt class_parent_opt class_body_opt

   76 class_params_opt: %empty
   77                 | LPAR class_field_list_e RPAR

   78 class_parent_opt: %empty
   79                 | EXTENDS parent_ref

   80 class_body_opt: %empty
   81               | CURV_LPAR prop_def_list_e CURV_RPAR

   82 parent_ref: ID parent_args_opt parent_with_opt

   83 parent_args_opt: %empty
   84                | LPAR expr_list_e RPAR

   85 parent_with_opt: %empty
   86                | WITH trait_list

   87 trait_def: opt_sealed TRAIT ID trait_parent_opt trait_body_opt

   88 opt_sealed: %empty
   89           | SEALED

   90 trait_parent_opt: %empty
   91                 | EXTENDS parent_ref

   92 trait_body_opt: %empty
   93               | CURV_LPAR prop_def_list_e CURV_RPAR

   94 aux_constructor_def: DEF THIS LPAR param_list_e RPAR ASSIGN THIS LPAR expr_list_e RPAR

   95 class_field_list_e: %empty
   96                   | class_field_list

   97 class_field_list: class_field
   98                 | class_field_list COMMA class_field

   99 class_field: ID COLON type
  100            | VAL ID COLON type

  101 prop_def_list_e: %empty
  102                | prop_def_list

  103 prop_def_list: member_def
  104              | prop_def_list SEPARATOR member_def

  105 member_def: THIS COLON ID RARROW def
  106           | member_modifiers def

  107 member_modifiers: %empty
  108                 | PRIVATE
  109                 | PROTECTED
  110                 | PROTECTED SQ_LPAR PACKAGE SQ_RPAR
  111                 | PRIVATE SQ_LPAR THIS SQ_RPAR
  112                 | PRIVATE SQ_LPAR PACKAGE SQ_RPAR
  113                 | OVERRIDE
  114                 | ABSTRACT PRIVATE
  115                 | ABSTRACT PROTECTED
  116                 | ABSTRACT PROTECTED SQ_LPAR PACKAGE SQ_RPAR
  117                 | ABSTRACT PRIVATE SQ_LPAR THIS SQ_RPAR
  118                 | ABSTRACT PRIVATE SQ_LPAR PACKAGE SQ_RPAR
  119                 | ABSTRACT OVERRIDE

  120 enum_def: OBJECT ID EXTENDS ENUMERATION CURV_LPAR expr_list_e CURV_RPAR

  121 expr: assign_expr

  122 assign_expr: or_expr
  123            | or_expr ASSIGN assign_expr
  124            | or_expr PLUS_ASSIGN assign_expr
  125            | or_expr MINUS_ASSIGN assign_expr
  126            | or_expr STAR_ASSIGN assign_expr
  127            | or_expr SLASH_ASSIGN assign_expr
  128            | or_expr PERCENT_ASSIGN assign_expr

  129 or_expr: and_expr
  130        | or_expr OR and_expr

  131 and_expr: bit_expr
  132         | and_expr AND bit_expr

  133 bit_expr: eq_expr
  134         | bit_expr BYTE_OR eq_expr
  135         | bit_expr BYTE_XOR eq_expr
  136         | bit_expr BYTE_AND eq_expr

  137 eq_expr: rel_expr
  138        | eq_expr EQ rel_expr
  139        | eq_expr NEQ rel_expr

  140 rel_expr: range_expr
  141         | rel_expr LESS_EQ range_expr
  142         | rel_expr GREATER_EQ range_expr
  143         | rel_expr LESS_NEQ range_expr
  144         | rel_expr GREATER_NEQ range_expr

  145 range_expr: cons_expr
  146           | cons_expr TO range_expr

  147 cons_expr: add_expr
  148          | add_expr CONS cons_expr

  149 add_expr: mul_expr
  150         | add_expr PLUS mul_expr
  151         | add_expr MINUS mul_expr

  152 mul_expr: unary_expr
  153         | mul_expr STAR unary_expr
  154         | mul_expr SLASH unary_expr
  155         | mul_expr PERCENT unary_expr

  156 unary_expr: postfix_expr
  157           | PLUS unary_expr
  158           | MINUS unary_expr
  159           | EXCL unary_expr
  160           | TILDA unary_expr

  161 postfix_expr: primary_expr
  162             | postfix_expr LPAR expr_list_e RPAR
  163             | postfix_expr SQ_LPAR type_list_e SQ_RPAR
  164             | postfix_expr DOT method_suffix
  165             | SUPER DOT method_suffix

  166 method_suffix: method_name
  167              | method_name LPAR expr_list_e RPAR
  168              | method_name SQ_LPAR type_list_e SQ_RPAR
  169              | method_name SQ_LPAR type_list_e SQ_RPAR LPAR expr_list_e RPAR

  170 method_name: ID
  171            | APPLY
  172            | UPDATE
  173            | HEAD
  174            | LAST
  175            | TOLIST
  176            | TOARRAY
  177            | EMPTY
  178            | CONCAT
  179            | RANGE
  180            | FILL
  181            | TABULATE
  182            | ITERATE
  183            | FROM

  184 primary_expr: LITINT
  185             | LITCHAR
  186             | LITSTR
  187             | ID
  188             | UNDERSCORE
  189             | TARRAY
  190             | TLIST
  191             | LPAR expr_list_e RPAR
  192             | block_expr
  193             | if_expr
  194             | match_expr
  195             | SOME LPAR expr RPAR
  196             | NONE
  197             | while_expr
  198             | do_while_expr
  199             | for_expr
  200             | YIELD LPAR expr_list_e RPAR
  201             | try_catch_expr
  202             | THROW NEW EXCEPTION LPAR RPAR
  203             | THROW NEW EXCEPTION LPAR expr RPAR
  204             | TYPE ID ASSIGN VALUE
  205             | ID DOT VALUE
  206             | IMPORT ID DOT UNDERSCORE
  207             | VAL id_list
  208             | VAR id_list
  209             | NEW type LPAR expr_list_e RPAR
  210             | iterable_once LPAR expr_list_e RPAR
  211             | ID RARROW expr
  212             | UNDERSCORE RARROW expr
  213             | NIL
  214             | LIST LPAR expr_list RPAR
  215             | CONS LPAR expr COMMA cons_expr RPAR
  216             | NEW CONS LPAR expr COMMA cons_expr RPAR

  217 iterable_once: LIST
  218              | VECTOR
  219              | SEQ
  220              | SET
  221              | MAP
  222              | RANGE
  223              | ARRAY

  224 expr_list: expr
  225          | expr_list COMMA expr

  226 expr_list_e: %empty
  227            | expr_list

  228 block_expr: CURV_LPAR stmt_list_e CURV_RPAR

  229 if_expr: IF LPAR expr RPAR expr
  230        | IF LPAR expr RPAR expr ELSE expr

  231 match_expr: postfix_expr MATCH CURV_LPAR case_list CURV_RPAR
  232           | postfix_expr MATCH CURV_LPAR except_case_list CURV_RPAR

  233 case_list: wildcard_case
  234          | case_list case

  235 wildcard_case: CASE UNDERSCORE RARROW expr

  236 case: CASE expr RARROW expr
  237     | CASE expr IF expr RARROW expr
  238     | CASE ID COLON type RARROW expr
  239     | CASE ID COLON type IF expr RARROW expr
  240     | CASE ID AT_SIGN expr RARROW expr
  241     | CASE ID AT_SIGN expr IF expr RARROW expr
  242     | CASE ID COLON type AT_SIGN expr RARROW expr
  243     | CASE ID COLON type AT_SIGN expr IF expr RARROW expr

  244 while_expr: WHILE LPAR expr RPAR expr

  245 do_while_expr: DO expr WHILE LPAR expr RPAR

  246 for_expr: FOR LPAR generator RPAR expr
  247         | FOR LPAR generator guard RPAR expr
  248         | FOR CURV_LPAR generator_list CURV_RPAR expr
  249         | FOR LPAR ID LARROW expr TO expr BY expr RPAR expr

  250 generator_list: generator
  251               | generator_list generator
  252               | generator_list guard

  253 generator: ID LARROW expr
  254          | ID LARROW expr TO expr
  255          | ID LARROW expr UNTIL expr

  256 guard: IF expr

  257 output: PRINT LPAR expr RPAR
  258       | PRINTLN LPAR expr RPAR
  259       | PRINTF LPAR LITSTR COMMA args_e RPAR
  260       | CONSOLE DOT ERR DOT PRINTLN LPAR expr RPAR

  261 input: READINT LPAR RPAR
  262      | READCHAR LPAR RPAR
  263      | READLINE LPAR RPAR

  264 args_e: %empty
  265       | args

  266 args: expr
  267     | args COMMA expr

  268 try_catch_expr: TRY expr CATCH CURV_LPAR err_case_list CURV_RPAR FINALLY expr
  269               | TRY expr CATCH CURV_LPAR err_case_list wildcard_err_case CURV_RPAR FINALLY expr

  270 err_case_list: err_case
  271              | err_case_list err_case

  272 err_case: CASE E COLON EXCEPTION RARROW PRINTLN LPAR expr RPAR

  273 wildcard_err_case: CASE UNDERSCORE COLON EXCEPTION RARROW PRINTLN LPAR expr RPAR

  274 except_case_list: except_case
  275                 | except_case_list SEPARATOR except_case

  276 except_case: CASE SUCCESS LPAR V RPAR RARROW expr
  277            | CASE FAILURE LPAR E RPAR RARROW expr
  278            | CASE NONFATAL LPAR E RPAR RARROW expr


