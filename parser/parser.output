    TLIST


State 360 conflicts: 1 shift/reduce


Grammar

    0 $accept: program $end

    1 program: %empty
    2        | program stmt

    3 stmt: def
    4     | expr ';'

    5 def: VAL ID '=' expr ';'
    6    | VAR ID '=' expr ';'
    7    | VAL ID ':' type '=' expr ';'
    8    | VAR ID ':' type '=' expr ';'

    9 type: TINT
   10     | TCHAR
   11     | TSTR
   12     | TARRAY
   13     | TARRAY '[' type ']'

   14 type_e: %empty
   15       | '[' type ']'

   16 read_type: READINT
   17          | READCHAR
   18          | READLINE

   19 expr: ID
   20     | '(' expr ')' R_ARROW expr
   21     | '_'
   22     | LITINT
   23     | LITCHAR
   24     | LITSTR
   25     | '(' expr ')'
   26     | '{' program '}'
   27     | expr '+' expr
   28     | expr '-' expr
   29     | expr '*' expr
   30     | expr '/' expr
   31     | expr '%' expr
   32     | '+' expr
   33     | '-' expr
   34     | expr EQ expr
   35     | expr NEQ expr
   36     | expr '<' expr
   37     | expr '>' expr
   38     | expr LESS_EQ expr
   39     | expr GREATER_EQ expr
   40     | expr '=' expr
   41     | expr PLUS_ASSIGN expr
   42     | expr MINUS_ASSIGN expr
   43     | expr STAR_ASSIGN expr
   44     | expr SLASH_ASSIGN expr
   45     | expr PERCENT_ASSIGN expr
   46     | type '(' expr_list_e ')'
   47     | NEW type '(' expr ')'
   48     | expr '.' array_postfix
   49     | expr '(' expr ')'
   50     | if_expr
   51     | while_expr
   52     | do_while_expr
   53     | for_expr
   54     | SCALA '.' IO '.' STDIN '.' read_type '(' ')'
   55     | PRINT '(' expr ')'
   56     | PRINTLN '(' expr ')'
   57     | PRINTF '(' expr_list ')'

   58 if_expr: IF '(' expr ')' expr
   59        | IF '(' expr ')' expr ELSE expr

   60 while_expr: WHILE '(' expr ')' expr

   61 do_while_expr: DO expr WHILE '(' expr ')'

   62 for_expr: FOR '(' generator_list ')' expr
   63         | FOR '{' generator_list '}' YIELD expr
   64         | expr '.' for_expr_postfix

   65 generator_list: ID L_ARROW expr range_e
   66               | generator_list ';' ID L_ARROW expr range_e
   67               | generator_list ';' IF expr
   68               | generator_list ';' expr

   69 range_e: %empty
   70        | TO expr
   71        | UNITL expr
   72        | TO expr BY expr
   73        | UNITL expr BY expr

   74 expr_list: expr
   75          | expr_list ',' expr

   76 expr_list_e: %empty
   77            | expr_list

   78 array_postfix: EMPTY type_e
   79              | APPLY '(' expr_list_e ')'
   80              | FILL type_e '(' expr ')' '(' expr ')'
   81              | TABULATE type_e '(' expr ')' '(' ID R_ARROW expr ')'
   82              | ITERATE type_e '(' expr ',' expr ')' '(' ID R_ARROW expr ')'
   83              | RANGE '(' expr ',' expr ')'
   84              | RANGE '(' expr ',' expr ',' expr ')'
   85              | CONCAT '(' expr_list_e ')'
   86              | COPY '(' expr ',' expr ',' expr ',' expr ',' expr ')'
   87              | COPY_OF '(' expr ',' expr ')'
   88              | FROM type_e '(' expr ')'
   89              | HEAD
   90              | HEAD_OPTION
   91              | LAST
   92              | LAST_OPTION
   93              | LIFT '(' expr ')'
   94              | APPLY_OR_ELSE '(' expr ',' expr ')'
   95              | UPDATE '(' expr ',' expr ')'
   96              | TO_ARRAY

   97 mk_string_postfix: MK_STRING '(' ')'
   98                  | MK_STRING '(' expr ')'
   99                  | MK_STRING '(' expr ',' expr ',' expr ')'

