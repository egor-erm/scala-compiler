Grammar

    0 $accept: program $end

    1 program: %empty
    2        | program stmt

    3 stmt: def
    4     | expr ';'

    5 def: VAL ID '=' expr ';'
    6    | VAR ID '=' expr ';'
    7    | VAL ID ':' type '=' expr ';'
    8    | VAR ID ':' type '=' expr ';'

    9 type: TINT
   10     | TCHAR
   11     | TSTR
   12     | TARRAY
   13     | TARRAY '[' type ']'

   14 type_e: %empty
   15       | '[' type ']'

   16 expr: ID
   17     | LITINT
   18     | LITCHAR
   19     | LITSTR
   20     | '(' expr ')'
   21     | '{' program '}'
   22     | expr '+' expr
   23     | expr '-' expr
   24     | expr '*' expr
   25     | expr '/' expr
   26     | expr '%' expr
