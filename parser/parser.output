Terminals unused in grammar

    TLIST


State 177 conflicts: 1 shift/reduce
State 457 conflicts: 1 shift/reduce


Grammar

    0 $accept: program $end

    1 program: %empty
    2        | program stmt

    3 stmt: def
    4     | expr ';'

    5 def: func_def ';'
    6    | var_def ';'
    7    | class_def ';'
    8    | trait_def ';'
    9    | enum_def ';'
   10    | def_prefix def

   11 enum_def: OBJECT ID EXTENDS ENUMERATION '{' TYPE ID '=' VALUE ';' VAL id_list '=' VALUE '}'

   12 def_prefix: ABSTRACT
   13           | SEALED
   14           | FINAL
   15           | OVERRIDE
   16           | LAZY
   17           | PRIVATE
   18           | PROTECTED
   19           | PUBLIC
   20           | PRIVATE '[' ID ']'
   21           | PRIVATE '[' THIS ']'

   22 trait_def: TRAIT ID
   23          | TRAIT ID '{' def_list_e '}'
   24          | TRAIT ID EXTENDS id_with_id
   25          | TRAIT ID EXTENDS id_with_id '{' def_list_e '}'

   26 class_def: CLASS ID
   27          | CLASS ID '{' def_list_e '}'
   28          | CLASS ID EXTENDS id_with_id
   29          | CLASS ID EXTENDS id_with_id '{' def_list_e '}'
   30          | CLASS ID '(' field_list_e ')'
   31          | CLASS ID '(' field_list_e ')' '{' def_list_e '}'
   32          | CLASS ID '(' field_list_e ')' EXTENDS id_with_id
   33          | CLASS ID '(' field_list_e ')' EXTENDS id_with_id '{' def_list_e '}'

   34 id_with_id: ID
   35           | ID '(' id_list_e ')'
   36           | id_with_id WITH ID
   37           | id_with_id WITH ID '(' id_list_e ')'

   38 id_list_e: %empty
   39          | id_list

   40 id_list: ID
   41        | id_list ',' ID

   42 field_list_e: %empty
   43             | field_list

   44 field_list: field
   45           | field_list ',' field

   46 field: VAL ID ':' type
   47      | VAR ID ':' type

   48 def_list_e: %empty
   49           | def_list

   50 def_list: def
   51         | def_list def

   52 func_def: DEF ID '(' param_list_e ')' '=' expr
   53         | DEF ID '(' param_list_e ')' ':' type '=' expr
   54         | VAL ID '=' '(' param_list_e ')' R_ARROW expr

   55 var_def: VAL ID '=' expr
   56        | VAR ID '=' expr
   57        | VAL ID ':' type '=' expr
   58        | VAR ID ':' type '=' expr
   59        | VAL ID '=' expr '_'

   60 param_list_e: %empty
   61             | param_list

   62 param_list: ID ':' type
   63           | param_list ',' ID ':' type

   64 type: var_type
   65     | func_type

   66 var_type: TINT
   67         | TDOUBLE
   68         | TCHAR
   69         | TSTR
   70         | TBOOL
   71         | TARRAY
   72         | TARRAY '[' type ']'

   73 func_type: '(' ')' R_ARROW type
   74          | '(' type_list ')' R_ARROW type

   75 type_list: type
   76          | type_list ',' type

   77 type_e: %empty
   78       | '[' type ']'

   79 read_type: READINT
   80          | READCHAR
   81          | READLINE

   82 expr: ID
   83     | IMPORT ID '.' '_'
   84     | SUPER
   85     | '(' expr ')' R_ARROW expr
   86     | '_'
   87     | LITINT
   88     | LITCHAR
   89     | LITSTR
   90     | LITBOOL
   91     | LITDOUBLE
   92     | '(' expr ')'
   93     | '{' program '}'
   94     | expr '+' expr
   95     | expr '-' expr
   96     | expr '*' expr
   97     | expr '/' expr
   98     | expr '%' expr
   99     | '+' expr
  100     | '-' expr
  101     | expr EQ expr
  102     | expr NEQ expr
  103     | expr '<' expr
  104     | expr '>' expr
  105     | expr LESS_EQ expr
  106     | expr GREATER_EQ expr
  107     | expr '=' expr
  108     | expr AND expr
  109     | expr '&' expr
  110     | expr OR expr
  111     | expr '|' expr
  112     | expr '^' expr
  113     | '!' expr
  114     | '~' expr
  115     | expr PLUS_ASSIGN expr
  116     | expr MINUS_ASSIGN expr
  117     | expr STAR_ASSIGN expr
  118     | expr SLASH_ASSIGN expr
  119     | expr PERCENT_ASSIGN expr
  120     | expr AND_ASSIGN
  121     | expr OR_ASSIGN
  122     | var_type '(' expr_list ')'
  123     | NEW var_type '(' expr ')'
  124     | NEW ID '(' expr_list ')'
  125     | expr '.' array_postfix
  126     | expr '(' expr ')'
  127     | if_expr
  128     | while_expr
  129     | do_while_expr
  130     | for_expr
  131     | SCALA '.' IO '.' STDIN '.' read_type '(' ')'
  132     | PRINT '(' expr ')'
  133     | PRINTLN '(' expr ')'
  134     | PRINTF '(' expr_list ')'
  135     | expr '.' ID
  136     | expr '.' ID '(' expr_list_e ')'

  137 if_expr: IF '(' expr ')' expr
  138        | IF '(' expr ')' expr ELSE expr

  139 while_expr: WHILE '(' expr ')' expr

  140 do_while_expr: DO expr WHILE '(' expr ')'

  141 for_expr: FOR '(' generator_list ')' expr
  142         | FOR '{' generator_list '}' YIELD expr
  143         | expr '.' for_expr_postfix

  144 generator_list: ID L_ARROW expr range_e
  145               | generator_list ';' ID L_ARROW expr range_e
  146               | generator_list ';' IF expr
  147               | generator_list ';' expr

  148 range_e: %empty
  149        | TO expr
  150        | UNITL expr
  151        | TO expr BY expr
  152        | UNITL expr BY expr

  153 expr_list: expr
  154          | expr_list ',' expr

  155 expr_list_e: %empty
  156            | expr_list

  157 array_postfix: EMPTY type_e
  158              | APPLY '(' expr_list_e ')'
  159              | FILL type_e '(' expr ')' '(' expr ')'
  160              | TABULATE type_e '(' expr ')' '(' ID R_ARROW expr ')'
  161              | ITERATE type_e '(' expr ',' expr ')' '(' ID R_ARROW expr ')'
  162              | RANGE '(' expr ',' expr ')'
  163              | RANGE '(' expr ',' expr ',' expr ')'
  164              | CONCAT '(' expr_list_e ')'
  165              | COPY '(' expr ',' expr ',' expr ',' expr ',' expr ')'
  166              | COPY_OF '(' expr ',' expr ')'
  167              | FROM type_e '(' expr ')'
  168              | HEAD
  169              | HEAD_OPTION
  170              | LAST
  171              | LAST_OPTION
  172              | LIFT '(' expr ')'
  173              | APPLY_OR_ELSE '(' expr ',' expr ')'
  174              | UPDATE '(' expr ',' expr ')'
  175              | TO_ARRAY

  176 mk_string_postfix: MK_STRING '(' ')'
  177                  | MK_STRING '(' expr ')'
  178                  | MK_STRING '(' expr ',' expr ',' expr ')'

  179 for_expr_postfix: FOREACH '(' expr ')'
  180                 | TAPEACH '(' expr ')'
  181                 | FILTER '(' expr ')'
