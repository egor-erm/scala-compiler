Terminals unused in grammar

    TLIST


Grammar

    0 $accept: program $end

    1 program: %empty
    2        | program stmt

    3 stmt: def
    4     | expr ';'

    5 def: VAL ID '=' expr ';'
    6    | VAR ID '=' expr ';'
    7    | VAL ID ':' type '=' expr ';'
    8    | VAR ID ':' type '=' expr ';'

    9 type: TINT
   10     | TCHAR
   11     | TSTR
   12     | TARRAY
   13     | TARRAY '[' type ']'

   14 type_e: '[' type ']'

   15 expr: ID
   16     | LITINT
   17     | LITCHAR
   18     | LITSTR
   19     | '(' expr ')'
   20     | expr '+' expr
   21     | expr '-' expr
   22     | expr '*' expr
   23     | expr '/' expr
   24     | expr '%' expr
   25     | '+' expr
   26     | '-' expr
   27     | expr EQ expr
   28     | expr NEQ expr
   29     | expr '<' expr
   30     | expr '>' expr
   31     | expr LESS_EQ expr
   32     | expr GREATER_EQ expr
   33     | expr '=' expr
   34     | expr PLUS_ASSIGN expr
   35     | expr MINUS_ASSIGN expr
   36     | expr STAR_ASSIGN expr
   37     | expr SLASH_ASSIGN expr
   38     | expr PERCENT_ASSIGN expr
   39     | type '(' expr_list_e ')'
   40     | NEW type '(' expr ')'
   41     | expr postfix
   42     | expr '(' expr ')'

   43 expr_list: expr
   44          | expr_list ',' expr

   45 expr_list_e: %empty
   46            | expr_list

   47 postfix: '.' EMPTY type_e
   48        | '.' APPLY '(' expr_list_e ')'
   49        | '.' FILL type_e '(' expr ')' '(' expr ')'
   50        | '.' TABULATE type_e '(' expr ')' '(' ID R_ARROW expr ')'
   51        | '.' ITERATE type_e '(' expr ',' expr ')' '(' ID R_ARROW expr ')'
   52        | '.' RANGE '(' expr ',' expr ')'
   53        | '.' RANGE '(' expr ',' expr ',' expr ')'
   54        | '.' CONCAT '(' expr_list_e ')'
   55        | '.' COPY '(' expr ',' expr ',' expr ',' expr ',' expr ')'
   56        | '.' COPY_OF '(' expr ',' expr ')'
   57        | '.' FROM type_e '(' expr ')'
   58        | '.' HEAD
   59        | '.' LAST
   60        | '.' LIFT '(' expr ')'
   61        | '.' APPLY_OR_ELSE '(' expr ',' expr ')'
   62        | '.' UPDATE '(' expr ',' expr ')'


